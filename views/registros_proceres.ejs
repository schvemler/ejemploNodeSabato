<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title><%= titulo %></title>
</head>
<body>
  <h1><%= titulo %></h1>

  <% if (datos.length === 0) { %>
    <p>No hay registros guardados aún.</p>
  <% } else { %>
    <table border="1" cellpadding="8" cellspacing="0">
      <thead>
        <tr>
          <th>ID</th>
          <th>Fecha de Naciemiento</th>
          <th>Nombre</th>
          <th>Descripción</th>
          <th>Logros</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% datos.forEach(item => { %>
          <tr>
            <td><%= item.id %></td>
            <td><%= item.fecha_nacimiento %></td>
            <td><%= item.nombre %></td>
            <td><%= item.descripcion %></td>
            <td><%= item.logros %></td>
            <td>
              <a href="/proceres/editar/<%= item.id %>">Editar</a> |
              <a href="/proceres/eliminar/<%= item.id %>" onclick="return confirm('¿Estás seguro de que quieres eliminar este registro?');">Eliminar</a>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>

  <br>
  <a href="/ingresar">Cargar Nuevo Registro</a> | 
  <a href="/">Volver al Inicio</a>
</body>
</html>