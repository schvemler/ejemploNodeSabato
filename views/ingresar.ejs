<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title><%= titulo %></title>
</head>
<body>
  <h1><%= titulo %></h1>
 
  <form action="/ingresar" method="POST">
    <div>
      <label for="nombre">Nombre del procer Argentino</label><br>
      <input type="text" id="nombre" name="nombre" required>
    </div>
    <br>
    <div>
      <label for="descripcion">Descripción:</label><br>
      <input type="text" id="descripcion" name="descripcion" required>
    </div>
    <br>
    <div>
      <label for="logros">logros:</label><br>
      <input type="texto" id="logros" name="logros" required>
    </div>
    <br>
    <div>
      <label for="monto">Fecha de Nacimiento</label><br>
      <input type="text" id="fecha_nacimiento" name="fecha_nacimiento" required>
    </div>
    <br>
    <button type="submit">Guardar Registro</button>
  </form>

  <br>
  <a href="/registros">Ver Tabla de Registros Guardados</a> | 
  <a href="/">Volver al Inicio</a>
</body>
</html> 