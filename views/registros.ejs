<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title><%= titulo %></title>
  <style>
    table { border-collapse: collapse; width: 100%; }
    th, td { border: 1px solid #ccc; padding: 8px; text-align: left; }
    th { background-color: #f4f4f4; }
  </style>
</head>
<body>
  <h1><%= titulo %></h1>

  <% if (registros.length === 0) { %>
    <p>No hay datos ingresados todavía.</p>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>Nombre</th>
          <th>Email</th>
          <th>Mensaje</th>
          <th>Fecha</th>
        </tr>
      </thead>
      <tbody>
        <% registros.forEach(item => { %>
          <tr>
            <td><%= item.nombre %></td>
            <td><%= item.email %></td>
            <td><%= item.mensaje %></td>
            <td><%= new Date(item.fecha).toLocaleString() %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>

  <br>
  <a href="/nuevo">Ingresar un nuevo registro</a>
</body>
</html>