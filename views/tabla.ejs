<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title><%= titulo %></title>
</head>
<body>
  <h1><%= titulo %></h1>

  <% if (datos.length === 0) { %>
    <p>No hay registros guardados aún.</p>
  <% } else { %>
    <table border="1" cellpadding="8" cellspacing="0">
      <thead>
        <tr>
          <th>ID</th>
          <th>Fecha de Registro</th>
          <th>Nombre</th>
          <th>Descripción</th>
          <th>Monto</th>
        </tr>
      </thead>
      <tbody>
        <% datos.forEach(item => { %>
          <tr>
            <td><%= item.id %></td>
            <td><%= item.fecha %></td>
            <td><%= item.nombre %></td>
            <td><%= item.descripcion %></td>
            <td>$<%= item.monto %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>

  <br>
  <a href="/ingresar">Cargar Nuevo Registro</a> | 
  <a href="/">Volver al Inicio</a>
</body>
</html>